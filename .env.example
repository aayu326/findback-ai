# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://pymesqzkrusrbuzaneoz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_NjUDK5_OBnvybSK_8WuGEA_myAHaFLv
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used for matching, embeddings, notifications.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (server only) ---
# gemini | openai (any OpenAI-compatible API) | none (disables AI; app still works)
AI_PROVIDER=gemini
AI_API_KEY=
# Verify the current free Flash model in Google AI Studio (see AI_SETUP.md)
AI_MODEL=gemini-flash-latest
# Must output 768 dims (Gemini: gemini-embedding-001 w/ outputDimensionality; OpenAI: text-embedding-3-small w/ dimensions)
AI_EMBEDDING_MODEL=gemini-embedding-001
# Only for AI_PROVIDER=openai (e.g. https://api.groq.com/openai/v1, https://openrouter.ai/api/v1)
AI_BASE_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
